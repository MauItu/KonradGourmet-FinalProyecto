<?xml version="1.0" encoding="UTF-8"?>
<!--
  Konrad Gourmet: proyecto padre de los servicios Spring Boot (rama stack-real).
  Cada módulo es un contenedor del diagrama de contenedores (página 3a del .drawio).
  Se compila dentro de Docker con ./plataforma/compilar.sh, sin Maven instalado.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.0</version>
        <relativePath/>
    </parent>

    <groupId>co.edu.konradlorenz</groupId>
    <artifactId>konrad-gourmet</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>Konrad Gourmet</name>

    <modules>
        <module>compartido</module>
        <module>service-registry</module>
        <module>api-gateway</module>
        <module>ms-identidad</module>
        <module>ms-menu</module>
        <module>ms-pedidos</module>
        <module>ms-inventario</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-cloud.version>2025.0.0</spring-cloud.version>
        <awssdk.version>2.31.50</awssdk.version>
        <shedlock.version>6.9.0</shedlock.version>
        <!-- El núcleo hexagonal vive en src/ (DEC-61): cada servicio copia de ahí su paquete al compilar. -->
        <nucleo.origen>${maven.multiModuleProjectDirectory}/../src/co/edu/konradlorenz</nucleo.origen>
        <nucleo.destino>${project.build.directory}/generated-sources/nucleo</nucleo.destino>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${awssdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>net.javacrumbs.shedlock</groupId>
                <artifactId>shedlock-spring</artifactId>
                <version>${shedlock.version}</version>
            </dependency>
            <dependency>
                <groupId>net.javacrumbs.shedlock</groupId>
                <artifactId>shedlock-provider-jdbc-template</artifactId>
                <version>${shedlock.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Copia el núcleo de src/; cada módulo dice qué paquetes con <includes>. -->
                <plugin>
                    <artifactId>maven-resources-plugin</artifactId>
                    <executions>
                        <execution>
                            <id>copiar-nucleo</id>
                            <phase>generate-sources</phase>
                            <goals>
                                <goal>copy-resources</goal>
                            </goals>
                            <configuration>
                                <outputDirectory>${nucleo.destino}/co/edu/konradlorenz</outputDirectory>
                                <overwrite>true</overwrite>
                                <!-- Por omisión no copia nada (Eureka y el gateway no tienen núcleo). -->
                                <resources>
                                    <resource>
                                        <directory>${nucleo.origen}</directory>
                                        <includes>
                                            <include>__ninguno__</include>
                                        </includes>
                                    </resource>
                                </resources>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>build-helper-maven-plugin</artifactId>
                    <executions>
                        <execution>
                            <id>fuente-nucleo</id>
                            <phase>generate-sources</phase>
                            <goals>
                                <goal>add-source</goal>
                            </goals>
                            <configuration>
                                <sources>
                                    <source>${nucleo.destino}</source>
                                </sources>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <finalName>app</finalName>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
