<?xml version="1.0" encoding="UTF-8"?>
<!-- ms-analitica: tablero BAM del director comercial (Strategy, HU-18) y promociones sugeridas al jefe de cocina con tendencia.detectada (HU-19), sobre su propio almacén de hechos armado con los eventos de negocio (página 4e). -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>co.edu.konradlorenz</groupId>
        <artifactId>konrad-gourmet</artifactId>
        <version>1.0.0</version>
    </parent>
    <artifactId>ms-analitica</artifactId>
    <name>ms-analitica</name>

    <dependencies>
        <dependency>
            <groupId>co.edu.konradlorenz</groupId>
            <artifactId>compartido</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <!-- TendenciasJob: con varias réplicas, una sola ejecuta el análisis semanal (DEC-36). -->
        <dependency>
            <groupId>net.javacrumbs.shedlock</groupId>
            <artifactId>shedlock-spring</artifactId>
        </dependency>
        <dependency>
            <groupId>net.javacrumbs.shedlock</groupId>
            <artifactId>shedlock-provider-jdbc-template</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copiar-nucleo</id>
                        <configuration>
                            <resources combine.self="override">
                                <resource>
                                    <directory>${nucleo.origen}</directory>
                                    <includes>
                                        <include>analitica/**</include>
                                        <!-- Los contratos de los tópicos que escucha (el paquete eventos de cada servicio, DEC-29):
                                             los 5 de NegocioEventsListener y menu.actualizado, del que NombresNegocio copia los
                                             nombres de los platos (DEC-90). -->
                                        <include>pedidos/eventos/PedidoRegistradoEvent.java</include>
                                        <include>inventario/eventos/StockBajoEvent.java</include>
                                        <include>solicitudes/eventos/SolicitudRegistradaEvent.java</include>
                                        <include>cotizaciones/eventos/CotizacionValidadaEvent.java</include>
                                        <include>ordenes/eventos/OrdenGeneradaEvent.java</include>
                                        <include>menu/eventos/MenuActualizadoEvent.java</include>
                                    </includes>
                                    <excludes>
                                        <exclude>analitica/adaptadores/**</exclude>
                                    </excludes>
                                </resource>
                                <!-- El cliente de la API de redes es Java puro (sin Spring): ms-analitica usa el mismo de src/,
                                     como ms-integracion con MinisterioSoapClient (DEC-71). -->
                                <resource>
                                    <directory>${nucleo.origen}</directory>
                                    <includes>
                                        <include>analitica/adaptadores/salida/RedesSocialesAdapter.java</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
