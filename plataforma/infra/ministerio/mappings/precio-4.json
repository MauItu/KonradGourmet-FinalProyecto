    "body": "<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\"><soap:Body><min:consultarPrecioEstandarResponse xmlns:min=\"http://precios.ministerio-comercio.simulado/\"><precio>14000.0</precio></min:consultarPrecioEstandarResponse></soap:Body></soap:Envelope>"
  }
}
