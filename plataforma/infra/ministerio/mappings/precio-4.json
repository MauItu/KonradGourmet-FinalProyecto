{
  "name": "Precio estándar: Pollo (producto 4)",
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/precios",
    "bodyPatterns": [
      {
        "matchesXPath": "//*[local-name()='codigoProducto' and normalize-space(text())='4']"
      }
