<mxCell id="n_umbral" value="El umbral del 25 % es un parámetro propio de ms-inventario: no se lee de ParametrosSistema (ms-administracion), así que no hace falta otro tópico." style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FFFBEA;strokeColor=#9CA3AF;fontColor=#374151;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="2705" y="1128" width="290" height="70" as="geometry"/></mxCell>
