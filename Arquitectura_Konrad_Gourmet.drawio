<mxCell id="v1" value="&lt;b style=&quot;font-size:26px&quot;&gt;Nivel 1 (C4) · Diagrama de contexto&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;El sistema como una caja: quién lo usa y con qué sistemas externos se integra. Las relaciones son flechas punteadas con su propósito y protocolo.&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#1F2D3D;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="60" as="geometry"/></mxCell>
