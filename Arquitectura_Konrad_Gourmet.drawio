<mxCell id="n_claim" value="El PDF se guarda en el almacén de objetos y cotizacion.enviada lleva solo pdfUrl (claim check): Kafka no transporta archivos. pdf(numero) lo lee del almacén para V14." style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FFFBEA;strokeColor=#9CA3AF;fontColor=#374151;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="3530" y="1660" width="340" height="58" as="geometry"/></mxCell>
