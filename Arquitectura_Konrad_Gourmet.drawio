<mxCell id="v15" value="&lt;b&gt;Microservicios&lt;/b&gt; (11) · réplicas mínimas → máximas&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ms-pedidos 4 → 20 · ms-inventario 2 → 6 · ms-cotizaciones 2 → 6 · ms-solicitudes 2 → 6&lt;br&gt;ms-identidad 3 → 8 · ms-menu, ms-ordenes, ms-notificaciones, ms-integracion,&lt;br&gt;ms-analitica y ms-administracion 2 → 4 · CPU objetivo 65 %&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;fontSize=11;fontSize=11;" vertex="1" parent="1"><mxGeometry x="790" y="320" width="560" height="120" as="geometry"/></mxCell>
