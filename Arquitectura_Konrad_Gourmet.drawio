<mxCell id="c3b_boundary" value="&lt;b&gt;ms-cotizaciones&lt;/b&gt; [Contenedor: Spring Boot 3 · Java 21]" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1168BD;strokeWidth=2;dashed=1;dashPattern=10 6;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontColor=#0B4884;fontSize=13;" vertex="1" parent="1"><mxGeometry x="220" y="520" width="2160" height="1040" as="geometry" /></mxCell>
<mxCell id="c3b_hex" value="&lt;b&gt;Núcleo hexagonal&lt;/b&gt; · dominio + aplicación&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;No importa Spring, JPA, Kafka ni HTTP: todo lo de afuera pasa por un puerto&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter;size=0.12;whiteSpace=wrap;html=1;fillColor=#D9F2E1;strokeColor=#1F7A45;strokeWidth=2;fontColor=#14532D;fontSize=12;align=left;verticalAlign=top;spacingLeft=250;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="260" y="800" width="2080" height="520" as="geometry" /></mxCell>
<mxCell id="c3b_app" value="&lt;b&gt;Casos de uso de cotización&lt;/b&gt; [Componente: aplicación · implementa GestionarCotizacionUseCase]" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#EAF7EE;strokeColor=#1F7A45;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontColor=#14532D;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="860" width="980" height="240" as="geometry" /></mxCell>
<mxCell id="c3b_title" value="&lt;b style=&quot;font-size:26px&quot;&gt;Nivel 3 (C4) · Diagrama de componentes · ms-cotizaciones&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Zoom sobre el contenedor ms-cotizaciones de la página 3a: sus componentes, el núcleo hexagonal y cómo se conecta con los demás contenedores. Se eligió este servicio porque atiende el flujo de compra de V13 a V20 y concentra tres patrones: Facade, Chain of Responsibility y Adapter.&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#1F2D3D;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2100" height="80" as="geometry" /></mxCell>
<mxCell id="c3b_spa" value="&lt;b style=&quot;font-size:13px&quot;&gt;SPA Konrad Gourmet&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Contenedor: React + TypeScript]&lt;/font&gt;&lt;br&gt;Ventanas V13 a V20" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2F6DB5;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="360" width="400" height="100" as="geometry" /></mxCell>
<mxCell id="c3b_gateway" value="&lt;b style=&quot;font-size:13px&quot;&gt;API Gateway&lt;/b&gt; «Facade»&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Contenedor: Spring Cloud Gateway]&lt;/font&gt;&lt;br&gt;Valida el JWT y enruta por prefijo" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2F6DB5;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="980" y="360" width="400" height="100" as="geometry" /></mxCell>
<mxCell id="c3b_ordenes" value="&lt;b style=&quot;font-size:13px&quot;&gt;ms-ordenes&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Contenedor: Spring Boot 3 · Java 21]&lt;/font&gt;&lt;br&gt;Genera la orden desde una cotización OPCIONADA" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2F6DB5;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1600" y="360" width="340" height="100" as="geometry" /></mxCell>
<mxCell id="c3b_p_auxiliar" value="&lt;b&gt;Auxiliar de compras&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Persona]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Genera y consulta cotizaciones;&lt;br&gt;gestiona proveedores&lt;/font&gt;" style="shape=actor;html=1;whiteSpace=nowrap;fillColor=#3D4FD0;strokeColor=#052E56;fontColor=#1F2D3D;fontSize=12;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="444" y="140" width="52" height="76" as="geometry" /></mxCell>
<mxCell id="c3b_p_director" value="&lt;b&gt;Director de compras&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Persona]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Registra valores y valida&lt;/font&gt;" style="shape=actor;html=1;whiteSpace=nowrap;fillColor=#B3267C;strokeColor=#052E56;fontColor=#1F2D3D;fontSize=12;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="734" y="140" width="52" height="76" as="geometry" /></mxCell>
<mxCell id="c3b_controller" value="&lt;b style=&quot;font-size:13px&quot;&gt;CotizacionRestController&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Componente: Spring MVC · adaptador de entrada]&lt;/font&gt;&lt;br&gt;&lt;br&gt;POST /api/cotizaciones (V13) · GET …/{id}/pdf (V14)&lt;br&gt;GET /api/cotizaciones (V15, V17, V20) · GET …/pendientes (V16)&lt;br&gt;PUT …/{id}/valores (V18) · POST …/{id}/validacion (V19)&lt;br&gt;GET …/{id} (V20, V21 y ms-ordenes) · POST …/{id}/reenvio (HU-12)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1FAF4;strokeColor=#2E6F8E;strokeWidth=1.5;fontColor=#1F2D3D;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="900" y="590" width="560" height="170" as="geometry" /></mxCell>
<mxCell id="c3b_prov_controller" value="&lt;b style=&quot;font-size:13px&quot;&gt;ProveedorRestController&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Componente: Spring MVC · adaptador de entrada]&lt;/font&gt;&lt;br&gt;&lt;br&gt;/api/proveedores/**: registrar, consultar (activos para V13), detalle, editar e inactivar" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1FAF4;strokeColor=#2E6F8E;strokeWidth=1.5;fontColor=#1F2D3D;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="360" y="590" width="480" height="150" as="geometry" /></mxCell>
<mxCell id="c3b_service" value="&lt;b style=&quot;font-size:12px&quot;&gt;CotizacionService&lt;/b&gt;&lt;br&gt;&lt;br&gt;Registra valores (V18), valida (V19), consulta (V15–V17, V20), da el detalle (V20, V21), entrega el PDF desde el almacén (V14), reenvía (HU-12) y marca CON_ORDEN" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F7A45;strokeWidth=1.5;fontColor=#1F2D3D;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="750" y="910" width="420" height="140" as="geometry" /></mxCell>
<mxCell id="c3b_facade" value="&lt;b style=&quot;font-size:12px&quot;&gt;GenerarCotizacionFacade&lt;/b&gt; «Facade»&lt;br&gt;&lt;br&gt;Un clic de V13 con una o varias solicitudes: precio sugerido por producto → guarda → genera el PDF → lo guarda en el almacén → publica cotizacion.enviada con pdfUrl. Si el Ministerio no responde: PENDIENTE_PRECIO" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F7A45;strokeWidth=1.5;fontColor=#1F2D3D;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="1260" y="910" width="390" height="140" as="geometry" /></mxCell>
<mxCell id="c3b_prov_service" value="&lt;b style=&quot;font-size:12px&quot;&gt;Gestión de proveedores&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Componente: aplicación · implementa GestionarProveedorUseCase]&lt;/font&gt;&lt;br&gt;&lt;br&gt;ProveedorService: NIT único, correo válido, inactivar sin borrar" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F7A45;strokeWidth=1.5;fontColor=#1F2D3D;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="400" y="980" width="260" height="160" as="geometry" /></mxCell>
<mxCell id="c3b_reglas" value="&lt;b style=&quot;font-size:12px&quot;&gt;Reglas de validación&lt;/b&gt;&lt;br&gt;«Chain of Responsibility»&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Componente: dominio]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Rechazada (más de +25 %) → Sospechosa (más de −50 %) → Opcionada (el resto).&lt;br&gt;&lt;i&gt;COT-018: +4,81 % → OPCIONADA&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F7A45;strokeWidth=1.5;fontColor=#1F2D3D;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="1790" y="880" width="270" height="160" as="geometry" /></mxCell>
<mxCell id="c3b_modelo" value="&lt;b style=&quot;font-size:12px&quot;&gt;Modelo de cotización&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Componente: dominio]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Cotizacion (una o varias solicitudes) ◆ ItemCotizacion, Proveedor y EstadoCotizacion (PENDIENTE_PRECIO · ENVIADA · RECHAZADA · SOSPECHOSA · OPCIONADA · CON_ORDEN). Calcula los totales y la diferencia porcentual" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F7A45;strokeWidth=1.5;fontColor=#1F2D3D;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="1790" y="1060" width="270" height="170" as="geometry" /></mxCell>
<mxCell id="c3b_ad_jpa" value="&lt;b style=&quot;font-size:12px&quot;&gt;CotizacionJpaAdapter · ProveedorJpaAdapter&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Componente: Spring Data JPA · adaptador de salida]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Implementa CotizacionRepositoryPort y ProveedorRepositoryPort" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1FAF4;strokeColor=#2E6F8E;strokeWidth=1.5;fontColor=#1F2D3D;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="400" y="1380" width="360" height="120" as="geometry" /></mxCell>
<mxCell id="c3b_ad_pdf" value="&lt;b style=&quot;font-size:12px&quot;&gt;PdfCotizacionAdapter&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Componente: OpenPDF · adaptador de salida]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Implementa GeneradorPdfPort" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1FAF4;strokeColor=#2E6F8E;strokeWidth=1.5;fontColor=#1F2D3D;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="1350" y="1380" width="230" height="120" as="geometry" /></mxCell>
<mxCell id="c3b_ad_almacen" value="&lt;b style=&quot;font-size:12px&quot;&gt;AlmacenObjetosAdapter&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Componente: cliente S3 compatible · adaptador de salida]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Implementa AlmacenArchivosPort" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1FAF4;strokeColor=#2E6F8E;strokeWidth=1.5;fontColor=#1F2D3D;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="1610" y="1380" width="250" height="120" as="geometry" /></mxCell>
<mxCell id="c3b_ad_listener" value="&lt;b style=&quot;font-size:12px&quot;&gt;OrdenGeneradaListener&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Componente: consumidor Kafka · adaptador de entrada]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Recibe orden.generada" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1FAF4;strokeColor=#2E6F8E;strokeWidth=1.5;fontColor=#1F2D3D;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="1070" y="1380" width="250" height="120" as="geometry" /></mxCell>
<mxCell id="c3b_ad_kafka" value="&lt;b style=&quot;font-size:12px&quot;&gt;KafkaEventPublisher&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Componente: librería compartido · productor Kafka]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Implementa EventPublisherPort: escribe en la tabla outbox y un relé publica en Kafka" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1FAF4;strokeColor=#2E6F8E;strokeWidth=1.5;fontColor=#1F2D3D;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="790" y="1380" width="250" height="120" as="geometry" /></mxCell>
<mxCell id="c3b_ad_precio" value="&lt;b style=&quot;font-size:12px&quot;&gt;PrecioSugeridoRestAdapter&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Componente: cliente REST · adaptador de salida]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Implementa PrecioSugeridoPort" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1FAF4;strokeColor=#2E6F8E;strokeWidth=1.5;fontColor=#1F2D3D;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="1890" y="1380" width="250" height="120" as="geometry" /></mxCell>
<mxCell id="c3b_bd" value="BD cotizaciones&lt;br&gt;[PostgreSQL]" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fillColor=#2F6DB5;strokeColor=#1E4F8A;fontColor=#FFFFFF;fontSize=10;" vertex="1" parent="1"><mxGeometry x="520" y="1620" width="120" height="80" as="geometry" /></mxCell>
<mxCell id="c3b_objetos" value="Almacén de objetos&lt;br&gt;[S3 compatible]&lt;br&gt;PDF y archivos" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fillColor=#2F6DB5;strokeColor=#1E4F8A;fontColor=#FFFFFF;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1675" y="1620" width="120" height="80" as="geometry" /></mxCell>
<mxCell id="c3b_broker" value="&lt;b style=&quot;font-size:12px&quot;&gt;Broker de eventos&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Contenedor: Apache Kafka]&lt;/font&gt;&lt;br&gt;Consumen: ms-notificaciones y ms-solicitudes (cotizacion.enviada); ms-analitica (cotizacion.validada); ms-administracion (auditoria.evento).&lt;br&gt;Entrega a ms-cotizaciones orden.generada (de ms-ordenes)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF4DE;strokeColor=#C27C00;fontColor=#7A4B00;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="1620" width="510" height="120" as="geometry" /></mxCell>
<mxCell id="c3b_integracion" value="&lt;b style=&quot;font-size:12px&quot;&gt;ms-integracion&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Contenedor: Spring Boot 3 · Java 21]&lt;/font&gt;&lt;br&gt;Responde desde la caché (Proxy) o consulta el SOAP del Ministerio" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2F6DB5;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1885" y="1620" width="260" height="120" as="geometry" /></mxCell>
<mxCell id="c3b_leg_t" value="&lt;b style=&quot;font-size:16px&quot;&gt;Cómo leer el diagrama&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#1F2D3D;" vertex="1" parent="1"><mxGeometry x="40" y="1810" width="500" height="26" as="geometry" /></mxCell>
<mxCell id="c3b_lt19" value="Llamada dentro del contenedor (en proceso); el «puerto» va en la etiqueta" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#1F2D3D;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="145" y="1848" width="470" height="24" as="geometry" /></mxCell>
<mxCell id="c3b_lt21" value="Llamada a otro contenedor [protocolo]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#1F2D3D;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="145" y="1882" width="470" height="24" as="geometry" /></mxCell>
<mxCell id="c3b_lt23" value="Acceso a datos (base de datos o almacén)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#1F2D3D;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="145" y="1916" width="470" height="24" as="geometry" /></mxCell>
<mxCell id="c3b_lt25" value="Evento asíncrono hacia o desde Kafka" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#1F2D3D;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="145" y="1950" width="470" height="24" as="geometry" /></mxCell>
<mxCell id="c3b_lt27" value="Una persona usa un contenedor" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#1F2D3D;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="145" y="1984" width="470" height="24" as="geometry" /></mxCell>
<mxCell id="c3b_sw28" value="" style="shape=hexagon;perimeter=hexagonPerimeter;size=0.12;whiteSpace=wrap;html=1;fillColor=#D9F2E1;strokeColor=#1F7A45;strokeWidth=2;fontColor=#14532D;fontSize=12;align=left;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="680" y="1860" width="120" height="56" as="geometry" /></mxCell>
<mxCell id="c3b_st29" value="Núcleo hexagonal" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#1F2D3D;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="640" y="1922" width="200" height="34" as="geometry" /></mxCell>
<mxCell id="c3b_sw30" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F7A45;strokeWidth=1.5;fontColor=#1F2D3D;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="910" y="1860" width="120" height="50" as="geometry" /></mxCell>
<mxCell id="c3b_st31" value="Componente del núcleo" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#1F2D3D;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="870" y="1916" width="200" height="34" as="geometry" /></mxCell>
<mxCell id="c3b_sw32" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1FAF4;strokeColor=#2E6F8E;strokeWidth=1.5;fontColor=#1F2D3D;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="1140" y="1860" width="120" height="50" as="geometry" /></mxCell>
<mxCell id="c3b_st33" value="Adaptador (entrada o salida)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#1F2D3D;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1100" y="1916" width="200" height="34" as="geometry" /></mxCell>
<mxCell id="c3b_sw34" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2F6DB5;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1370" y="1860" width="120" height="50" as="geometry" /></mxCell>
<mxCell id="c3b_st35" value="Otro contenedor" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#1F2D3D;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1330" y="1916" width="200" height="34" as="geometry" /></mxCell>
<mxCell id="c3b_sw36" value="" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fillColor=#2F6DB5;strokeColor=#1E4F8A;fontColor=#FFFFFF;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1600" y="1860" width="80" height="56" as="geometry" /></mxCell>
<mxCell id="c3b_st37" value="Base de datos o almacén" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#1F2D3D;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1560" y="1922" width="160" height="34" as="geometry" /></mxCell>
<mxCell id="c3b_sw38" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF4DE;strokeColor=#C27C00;fontColor=#7A4B00;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1790" y="1860" width="120" height="50" as="geometry" /></mxCell>
<mxCell id="c3b_st39" value="Broker de eventos" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#1F2D3D;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1750" y="1916" width="200" height="34" as="geometry" /></mxCell>
<mxCell id="c3b_notes" value="&lt;b&gt;Decisiones del diagrama&lt;/b&gt;&lt;br&gt;• CotizacionService y GenerarCotizacionFacade forman un solo componente de aplicación: los dos usan los puertos de repositorio, almacén y eventos; solo la fachada usa PrecioSugeridoPort y GeneradorPdfPort. Sus clases y métodos están en la página 4c.&lt;br&gt;• Los puertos (interfaces) se nombran en las flechas que cruzan el borde del hexágono, que es donde viven.&lt;br&gt;• El PDF se guarda en el almacén con AlmacenArchivosPort, y cotizacion.enviada lleva solo pdfUrl (claim check)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#1F2D3D;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="2040" width="2000" height="80" as="geometry" /></mxCell>
