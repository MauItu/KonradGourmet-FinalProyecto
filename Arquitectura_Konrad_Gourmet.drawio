<mxCell id="c3a_boundary" value="&lt;b&gt;Sistema de Abastecimiento Konrad Gourmet&lt;/b&gt; [Sistema de software]" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1168BD;strokeWidth=2;dashed=1;dashPattern=10 6;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontColor=#0B4884;fontSize=13;" vertex="1" parent="1"><mxGeometry x="560" y="380" width="3780" height="1070" as="geometry" /></mxCell>
<mxCell id="c3a_group" value="&lt;b&gt;Microservicios&lt;/b&gt; [Spring Boot 3 · Java 21 · Kubernetes] — once contenedores sin estado, uno por subdominio, cada uno dueño de su base de datos. Por dentro son hexagonales (nivel 4: páginas 4a–4e)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#8FA7C8;dashed=1;dashPattern=10 6;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontColor=#1F2D3D;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="740" width="3700" height="440" as="geometry" /></mxCell>
<mxCell id="c3a_bus" value="&lt;b style=&quot;font-size:14px&quot;&gt;Broker de eventos&lt;/b&gt; [Contenedor: Apache Kafka · 3 brokers · factor de réplica 3 · retención 7 días · cola de errores]&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;menu.actualizado · pedido.registrado · inventario.stock-bajo · solicitud.registrada · solicitud.en-tramite · cotizacion.enviada · cotizacion.validada · orden.generada · auditoria.evento · tendencia.detectada&lt;/font&gt;&lt;br&gt;&lt;br&gt;Coreografía publicar/suscribir · eventos inmutables · entrega al menos una vez · consumidores idempotentes" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF4DE;strokeColor=#C27C00;fontColor=#7A4B00;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=16;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="1240" width="3700" height="170" as="geometry" /></mxCell>
<mxCell id="c3a_title" value="&lt;b style=&quot;font-size:26px&quot;&gt;Nivel 2 (C4) · Diagrama de contenedores&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Zoom sobre el Sistema de Abastecimiento: las aplicaciones y almacenes de datos que se despliegan por separado, cómo se reparten las responsabilidades y cómo se comunican. Cada flecha lleva su propósito y su protocolo.&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#1F2D3D;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2700" height="70" as="geometry" /></mxCell>
<mxCell id="c3a_registry" value="&lt;b style=&quot;font-size:13px&quot;&gt;Service Registry&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Contenedor: Eureka]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Directorio vivo de instancias; 2 réplicas, latido cada 30 s" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2F6DB5;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="640" y="470" width="320" height="120" as="geometry" /></mxCell>
<mxCell id="c3a_web" value="&lt;b style=&quot;font-size:13px&quot;&gt;Servidor web&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Contenedor: Nginx detrás de CDN + WAF]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Entrega los archivos estáticos de la SPA" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2F6DB5;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1000" y="470" width="320" height="120" as="geometry" /></mxCell>
<mxCell id="c3a_spa" value="&lt;b style=&quot;font-size:14px&quot;&gt;SPA Konrad Gourmet&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Contenedor: React + TypeScript · se ejecuta en el navegador]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Las 23 ventanas, responsive para web y móvil. El menú lateral de cada rol llega en el JWT" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2F6DB5;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1460" y="470" width="640" height="120" as="geometry" /></mxCell>
<mxCell id="c3a_gateway" value="&lt;b style=&quot;font-size:14px&quot;&gt;API Gateway&lt;/b&gt; «Facade»&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Contenedor: Spring Cloud Gateway]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Punto único de entrada detrás del balanceador L7: valida el JWT, limita la tasa y enruta por prefijo" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2F6DB5;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2320" y="470" width="460" height="120" as="geometry" /></mxCell>
