<mxCell id="n_catalogo" value="Cada réplica de ms-pedidos lee el catálogo de su base, no de memoria: así cualquier réplica atiende V03 aunque el evento lo haya consumido otra del mismo grupo." style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FFFBEA;strokeColor=#9CA3AF;fontColor=#374151;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="70" y="640" width="330" height="70" as="geometry"/></mxCell>
