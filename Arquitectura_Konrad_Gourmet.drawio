<mxCell id="n_platos" value="El plato queda asociado a la sucursal y al usuario que lo crea, y su nombre es único en la sucursal (existeNombre). editar() y desactivar() publican menu.actualizado; con activo = false el plato sale del catálogo de los meseros. Sin ventana en el prototipo (HU-04)." style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FFFBEA;strokeColor=#9CA3AF;fontColor=#374151;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1648" y="190" width="330" height="96" as="geometry"/></mxCell>
